<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_compose_message_wizard_form_cc_bcc" model="ir.ui.view">
        <field name="name">mail.compose.message.form.cc.bcc</field>
        <field name="model">mail.compose.message</field>
        <field name="inherit_id" ref="mail.email_compose_message_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ids']" position="attributes">
                <attribute name="string">To</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_ids']" position="after">
                <field
                    name="partner_cc_ids"
                    string="Cc"
                    widget="many2many_tags_email"
                    invisible="composition_mode != 'comment'"
                />
                <field
                    name="partner_bcc_ids"
                    string="Bcc"
                    widget="many2many_tags_email"
                    invisible="composition_mode != 'comment'"
                />
            </xpath>
        </field>
    </record>
</odoo>
