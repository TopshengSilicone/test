<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_cc_bcc" model="ir.ui.view">
        <field name="name">res.company.form.cc.bcc</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="default_partner_cc_ids" widget="many2many_tags_email"/>
                <field name="default_partner_bcc_ids" widget="many2many_tags_email"/>
            </xpath>
        </field>
    </record>
</odoo>
