<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mail_cc_bcc" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.mail.cc.bcc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Chatter Email Recipients" name="mail_cc_bcc_settings_block">
                    <setting string="Default Cc recipients" id="mail_cc_bcc_default_cc">
                        <field name="default_partner_cc_ids" widget="many2many_tags_email"/>
                    </setting>
                    <setting string="Default Bcc recipients" id="mail_cc_bcc_default_bcc">
                        <field name="default_partner_bcc_ids" widget="many2many_tags_email"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
