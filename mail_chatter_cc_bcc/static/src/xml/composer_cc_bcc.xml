<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mail_chatter_cc_bcc.Composer" t-inherit="mail.Composer" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'o-mail-Composer')][1]" position="inside">
            <div class="o-mail-Composer-ccBcc mt-1" t-if="props.composer?.composerType === 'message'">
                <div class="d-flex align-items-center mb-1">
                    <label class="me-2 text-muted">CC:</label>
                    <input
                        type="text"
                        class="form-control form-control-sm"
                        placeholder="email1@domain.com, email2@domain.com"
                        t-att-value="props.composer.ccEmails or ''"
                        t-on-input="(ev) => props.composer.ccEmails = ev.target.value"
                    />
                </div>
            </div>
        </xpath>
    </t>
</templates>
